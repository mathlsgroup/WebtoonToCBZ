{
  "name": "webtoon-to-cbz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && web-ext run --source-dir dist --firefox=firefox",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test tests/core.test.cjs",
    "check:extension": "web-ext lint --source-dir dist --no-config-discovery",
    "native:install": "node native-host/install.cjs",
    "native:uninstall": "node native-host/install.cjs --uninstall",
    "test:native": "node --test tests/native.test.cjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.7.3",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "jszip": "^3.10.1"
  }
}
